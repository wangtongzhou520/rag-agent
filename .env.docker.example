# Copy to a private file and run: docker compose --env-file .env.docker up -d --build
COMPOSE_PROJECT_NAME=ragent
RAGENT_IMAGE_TAG=local

POSTGRES_DB=ragagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
# 仅用于从宿主机直连容器内的 PG；如需复用本机已有的 5432，保持该非默认端口即可。
POSTGRES_PORT=15432

REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_PORT=16379

API_PORT=9090
FRONTEND_PORT=5173

# Keep false for first boot. Enable only after creating an administrator and replacing JWT_SECRET.
RAGENT_AUTH_ENABLED=false
JWT_SECRET=replace-with-at-least-32-random-characters
RAGENT_EVAL_ENABLED=false

# Optional until model-backed ingestion or chat is exercised.
BAILIAN_API_KEY=
